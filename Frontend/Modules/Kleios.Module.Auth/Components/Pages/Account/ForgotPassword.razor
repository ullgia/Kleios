@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@inject ILogger<ForgotPassword> Logger

<PageTitle>Password Dimenticata - Kleios</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="min-height: 100vh;">
    <MudPaper Elevation="3" Class="pa-8" Style="width: 100%; max-width: 450px;">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Class="mr-2" />
            Password Dimenticata
        </MudText>
        
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Color="Color.Secondary">
            Inserisci la tua email per reimpostare la password
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" CloseIconClicked="@(() => _errorMessage = null)" ShowCloseIcon="true">
                @_errorMessage
            </MudAlert>
        }

        @if (_isSuccess)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Email inviata! Controlla la tua casella di posta per le istruzioni.
            </MudAlert>
        }

        <EditForm Model="@_forgotPasswordModel" OnValidSubmit="@HandleForgotPasswordAsync">
            <DataAnnotationsValidator />
            
            <MudTextField Label="Email" 
                          @bind-Value="_forgotPasswordModel.Email" 
                          For="@(() => _forgotPasswordModel.Email)"
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          Class="mb-4"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email" />

            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_isLoading"
                       Class="mb-3">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Invio in corso...</span>
                }
                else
                {
                    <span>Invia Email</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudLink Href="/Account/Login" Typo="Typo.body2">Torna al Login</MudLink>
            <MudLink Href="/Account/Register" Typo="Typo.body2">Registrati</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private ForgotPasswordModel _forgotPasswordModel = new();
    private bool _isLoading;
    private bool _isSuccess;
    private string? _errorMessage;

    private async Task HandleForgotPasswordAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _isSuccess = false;

        try
        {
            // TODO: Implementare chiamata al backend per reset password
            Logger.LogInformation("Password reset requested for email: {Email}", _forgotPasswordModel.Email);
            
            // Simuliamo un delay
            await Task.Delay(1000);
            
            _isSuccess = true;
            
            // Reset il form
            _forgotPasswordModel = new();
        }
        catch (Exception ex)
        {
            _errorMessage = "Errore durante l'invio dell'email. Riprova più tardi.";
            Logger.LogError(ex, "Error during password reset for email: {Email}", _forgotPasswordModel.Email);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "L'email è obbligatoria")]
        [EmailAddress(ErrorMessage = "Inserisci un'email valida")]
        public string Email { get; set; } = string.Empty;
    }
}
