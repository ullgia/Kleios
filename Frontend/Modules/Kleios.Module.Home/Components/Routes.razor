@using Kleios.Frontend.Components.App
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Kleios.Frontend.Components.Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == false)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p role="alert">Non sei autorizzato ad accedere a questa risorsa.</p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Non trovato</PageTitle>
            <LayoutView Layout="typeof(Kleios.Frontend.Components.Layout.MainLayout)">
                <p role="alert">Spiacente, non c'è nulla a questo indirizzo.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
